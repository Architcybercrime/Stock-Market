# Copy to .env and fill in. Never commit .env.

# --- Environment ---
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=stockmarket
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO locally, S3 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=stockmarket-data
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_REGION=us-east-1

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Data ---
DATA_ROOT=./data

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Trading mode ---
# paper | live   — guarded; live requires additional signed flag
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# --- Risk limits (defaults; override per portfolio) ---
RISK_MAX_DAILY_LOSS_PCT=0.02      # 2% of NAV
RISK_MAX_DRAWDOWN_PCT=0.10        # 10% peak-to-trough kills trading
RISK_MAX_POSITION_PCT=0.05        # 5% NAV per single position
RISK_MAX_SECTOR_PCT=0.25          # 25% NAV per sector
RISK_MAX_LEVERAGE=1.0             # No leverage by default

# --- Broker (paper by default) ---
# Alpaca example (only used if TRADING_MODE=live and credentials present)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- News / sentiment (optional) ---
NEWSAPI_KEY=
